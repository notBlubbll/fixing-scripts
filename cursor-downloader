(async () => {
    // 1. Select container elements that link to the cursor page and contain the image
    const items = document.querySelectorAll('a.item-img');
    const downloadList = [];

    // 2. Extract inner title and transformed image URL
    items.forEach(item => {
        const img = item.querySelector('img');
        if (!img) return;

        let src = img.src || img.getAttribute('src');
        if (!src) return;

        // Transform URL: replace '/medium/' with '/' to get the full-size image
        let realUrl = src.replace('/medium/', '/');

        // Extract title, clean unsafe file characters (like / \ : * ? " < > |), but keep spaces
        let rawTitle = item.getAttribute('title') || img.getAttribute('alt') || 'cursor';
        let safeName = rawTitle.replace(/[/\\?%*:|"<>]/g, '').trim();

        // Get file extension (.png, etc.) from the URL
        let extension = realUrl.split('.').pop().split('?')[0] || 'png';

        downloadList.push({
            url: realUrl,
            filename: `${safeName}.${extension}`
        });
    });

    console.log(`Found ${downloadList.length} images. Starting downloads...`);

    let index = 1;
    for (const item of downloadList) {
        try {
            const response = await fetch(item.url);
            const blob = await response.blob();
            const blobUrl = window.URL.createObjectURL(blob);
            
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = blobUrl;
            a.download = item.filename;
            
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            
            window.URL.revokeObjectURL(blobUrl);
            console.log(`[${index}/${downloadList.length}] Downloaded: ${item.filename}`);
            index++;
            
            // 300ms delay to prevent browser blocking rapid bulk downloads
            await new Promise(resolve => setTimeout(resolve, 300));
        } catch (err) {
            console.error(`Failed to download ${item.filename}:`, err);
        }
    }
    console.log('All downloads completed!');
})();
